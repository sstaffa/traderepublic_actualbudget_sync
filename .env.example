# Leave empty to disable. Default: every day at 17:00.
SYNC_CRON=0 17 * * *

# Optional: protect the UI and API with Basic Authentication
# if both values are provided.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Trade Republic (pytr)
# When not running in mock mode, provide valid credentials.
TR_PHONE_NUMBER=
TR_PIN=
# Persistent cookie/session location. In Docker this should live on a volume, e.g. /data/pytr_cookies.json.
TR_COOKIES_FILE=/data/pytr_cookies.json

# Actual Budget server instance
ACTUAL_URL=http://actualbudget:5006
ACTUAL_PASSWORD=

# Encryption password for the Actual budget file
# (only required if the budget is encrypted)
ACTUAL_ENCRYPTION_PASSWORD=

# Budget name or file ID
ACTUAL_BUDGET_ID=

# Actual accounts automatically created for Trade Republic
ACTUAL_CASH_ACCOUNT_NAME=Trade Republic Cash
ACTUAL_CASH_ACCOUNT_OFFBUDGET=false
ACTUAL_DEPOT_ACCOUNT_NAME=Trade Republic Depot
ACTUAL_DEPOT_ACCOUNT_OFFBUDGET=true

# Optional: external account used for
# BANK_TRANSACTION_INCOMING / BANK_TRANSACTION_OUTGOING
ACTUAL_TRANSFER_ACCOUNT_NAME=

# Optional: if true, automatically creates an external
# transfer counterpart when no matching transaction exists
TR_AUTOCREATE_TRANSFER=false
# Existing transfer matching window/tolerance
TR_TRANSFER_MATCH_DAYS=3
TR_TRANSFER_MATCH_TOLERANCE_CENTS=0

# Actual Budget notes
INCLUDE_RAW_IN_NOTES=0
INCLUDE_STATUS_IN_NOTES=0

# execute rules in Actual Budget after push
RUN_RULES_AFTER_SYNC=1
RUN_RULES_ON_ALL_TRANSACTIONS=1

# Depot Section
DEPOT_SYNC_CRON=0 18 * * *
DEPOT_SYNC_INTERVAL_DAYS=30

# ACTUAL_SUB_DEPOTS={"Emergency account": ["LU0908500753"], "Retirement": ["IE00B4L5Y983", "IE00B3YCGJ38"]}
ACTUAL_SUB_DEPOTS={"Emergency account": ["<ISIN of TR positions>"]}
ACTUAL_SUB_DEPOT_OFFBUDGET=true
